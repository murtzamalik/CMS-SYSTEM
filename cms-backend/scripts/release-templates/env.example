# CMS — environment example (copy values securely; do not commit real secrets)
# Backend (Java 21) — port 8015

CMS_DB_URL=jdbc:oracle:thin:@//HOST:1521/ORCLPDB1
CMS_DB_USERNAME=CMS
CMS_DB_PASSWORD=CHANGE_ME

# Prefer also setting Spring-native names in some hosts:
# SPRING_DATASOURCE_URL=...
# SPRING_DATASOURCE_USERNAME=...
# SPRING_DATASOURCE_PASSWORD=...

CMS_JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_CHARS
CMS_JWT_EXPIRATION_MS=900000

CARD_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
CMS_CARD_HASH_SALT=cms-pan-salt

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js) — set before npm run build
NEXT_PUBLIC_API_BASE_URL=http://localhost:8015
